BoxLayout:
    orientation: 'vertical'
    padding: 20
    spacing: 10

    BoxLayout:
        orientation: 'horizontal'
        spacing: 10
        size_hint_y: 0.3

        Button:
            text: '↑'
            background_color: (0.3, 0.3, 0.3, 1)
            on_press: app.handle_increment(1)

        TextInput:
            id: input_miles
            text: ''
            multiline: False
            input_filter: 'float'
            on_text: app.handle_calculate()
            background_color: (1, 1, 1, 1)
            foreground_color: (0, 0, 0, 1)

        Button:
            text: '↓'
            background_color: (0.3, 0.3, 0.3, 1)
            on_press: app.handle_increment(-1)

    # 可选按钮（如需要按钮式转换时可启用）
    # Button:
    #     text: 'Convert'
    #     background_color: (0.3, 0.3, 0.3, 1)
    #     on_press: app.handle_calculate()

    Label:
        text: app.output_text
        color: (1, 1, 0, 1)
        font_size: 32
        size_hint_y: 0.4
        bold: True
        canvas.before:
            Color:
                rgba: (0, 0, 0, 1)
            Rectangle:
                pos: self.pos
                size: self.size

